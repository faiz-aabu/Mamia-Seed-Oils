{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MamiaSeedsOil.Web": "Information"
    }
  },
  "SecurityHeaders": {
    "Enabled": true,
    "EnableCsp": true,
    "EnableHstsHeader": true,
    "EnableXContentTypeOptions": true,
    "EnableFrameDeny": true,
    "EnableReferrerPolicy": true,
    "EnablePermissionsPolicy": true,
    "EnableCrossOriginPolicies": true
  },
  "Observability": {
    "SlowRequestThresholdMs": 1200,
    "EnableRequestStartLogs": false
  },
  "SiteOperations": {
    "MaintenanceModeEnabled": false
  },
  "FeatureFlags": {
    "EnableAiAssistant": true,
    "EnablePartnershipCentre": true,
    "EnableStatusEndpoints": true
  },
  "FutureDataConnections": {
    "PrimaryConnectionString": "",
    "ReadReplicaConnectionString": "",
    "Provider": "[To Be Updated]"
  },
  "FileHandling": {
    "MaxUploadBytes": 5242880,
    "AllowedExtensions": [ ".pdf", ".png", ".jpg", ".jpeg", ".webp" ],
    "AllowedContentTypes": [ "application/pdf", "image/png", "image/jpeg", "image/webp" ]
  }
}
