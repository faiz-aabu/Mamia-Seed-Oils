{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "MamiaSeedsOil.Web": "Debug"
    }
  },
  "Observability": {
    "SlowRequestThresholdMs": 2000,
    "EnableRequestStartLogs": true
  },
  "SecurityHeaders": {
    "EnableCsp": true,
    "EnableHstsHeader": false
  },
  "EmailDelivery": {
    "RecipientEmail": "info@mamiaseedsoil.com",
    "FromEmail": "noreply@mamiaseedsoil.com",
    "FromName": "Mamia Seeds Oil Limited",
    "Smtp": {
      "Enabled": true,
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "",
      "UseStartTls": true
    }
  },
  "SiteOperations": {
    "MaintenanceModeEnabled": false
  }
}
