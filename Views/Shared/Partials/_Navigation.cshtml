@model MamiaSeedsOil.Web.ViewModels.HomePageViewModel

@{
    Model.Placeholders.TryGetValue("companyLogo", out var logoPlaceholder);
}

<nav aria-label="Primary navigation">
    <a class="brand" href="/" aria-label="@($"{Model.Company.Name} home")">
        <img class="brand-mark"
             src="~/images/logo/Logo.png"
             alt=""
             width="40"
             height="40"
             loading="eager"
             decoding="async"
             asp-append-version="true" />
        <span class="brand-text">@Model.Company.Name</span>
    </a>
    @if (logoPlaceholder is not null)
    {
        <span class="sr-only">@logoPlaceholder.SubLabel</span>
    }

    <ul class="nav-links" id="primary-menu">
        @foreach (var item in Model.NavigationItems)
        {
            var href = item.Anchor.StartsWith("#", StringComparison.Ordinal) ? $"/{item.Anchor}" : item.Anchor;
            <li><a href="@href">@item.Text</a></li>
        }
    </ul>

    <a class="nav-cta" href="/become-distributor">Become a Distributor</a>
    <button class="menu-btn" type="button" aria-label="Open menu" data-open-label="Open menu" data-close-label="Close menu" aria-expanded="false" aria-controls="primary-menu">
        <span></span><span></span><span></span>
    </button>
</nav>
