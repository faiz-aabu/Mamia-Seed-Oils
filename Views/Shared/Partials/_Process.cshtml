@model IReadOnlyList<MamiaSeedsOil.Web.ViewModels.SimpleCardViewModel>

<section class="process" id="process" aria-labelledby="process-title">
    <div class="wrap">
        <div class="section-head">
            <span class="eyebrow">Process</span>
            <h2 id="process-title">Process</h2>
            <p>From sourcing to refined output, our production process is built for consistency and traceability.</p>
        </div>
        <div class="process-strip">
            @for (var i = 0; i < Model.Count; i++)
            {
                var step = Model[i];
                <div class="process-step">
                    <span class="p-num">@((i + 1).ToString("D2"))</span>
                    <h4>@step.Title</h4>
                    <p>@step.Description</p>
                </div>
            }
        </div>
    </div>
</section>
