@model MamiaSeedsOil.Web.ViewModels.HomePageViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<MamiaSeedsOil.Web.Resources.SharedResource> T

@{
    var phoneEntries = (Model.Company.Phone ?? string.Empty)
        .Split(['/', ';', ','], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Where(entry => !string.IsNullOrWhiteSpace(entry))
        .ToList();
}

<section class="contact-section" id="contact" aria-labelledby="contact-title">
    <div class="wrap contact-grid">
        <div class="contact-info">
            <span class="eyebrow">@Model.Contact.Eyebrow</span>
            <h2 class="contact-title" id="contact-title">@Model.Contact.Title</h2>
            <div class="item">
                <h3>@T["ContactAddress"]</h3>
                <p>@Model.Company.AddressLine1,<br>@Model.Company.AddressLine2</p>
            </div>
            <div class="item">
                <h3>@T["ContactPhoneWhatsapp"]</h3>
                @foreach (var phone in phoneEntries)
                {
                    var phoneHref = phone.Replace(" ", string.Empty);
                    <p><a href="tel:@phoneHref" aria-label="@string.Format(T["ContactCallCompanyAriaTemplate"], Model.Company.Name)">@phone</a></p>
                }
            </div>
            <div class="item">
                <h3>@T["ContactEmail"]</h3>
                <p><a href="mailto:@Model.Company.Email" aria-label="@string.Format(T["ContactEmailCompanyAriaTemplate"], Model.Company.Name)">@Model.Company.Email</a></p>
            </div>
            <div class="item">
                <h3>@T["ContactBusinessHours"]</h3>
                <p>@Model.Company.BusinessHours</p>
            </div>
        </div>
        <div>
            <form class="contact-form" data-contact-form data-success-message="@Model.Contact.FormSuccessMessage" data-submitting-message="@T["ContactSubmitting"]" data-failed-message="@T["ContactSubmitFailed"]" aria-label="@T["ContactFormAria"]">
                <label class="sr-only" for="full-name">@T["ContactFullName"]</label>
                <input id="full-name" name="fullName" type="text" placeholder="@T["ContactFullName"]" autocomplete="name" required>

                <label class="sr-only" for="company-name">@T["ContactCompany"]</label>
                <input id="company-name" name="company" type="text" placeholder="@T["ContactCompany"]" autocomplete="organization">

                <label class="sr-only" for="email-address">@T["ContactEmailAddress"]</label>
                <input id="email-address" name="email" type="email" placeholder="@T["ContactEmailAddress"]" autocomplete="email" required>

                <label class="sr-only" for="phone-number">@T["ContactPhoneNumber"]</label>
                <input id="phone-number" name="phone" type="tel" placeholder="@T["ContactPhoneNumber"]" autocomplete="tel">

                <label class="sr-only" for="requirements">@T["ContactRequirements"]</label>
                <textarea id="requirements" name="requirements" rows="4" placeholder="@T["ContactRequirements"]"></textarea>

                <p class="form-status" data-form-status aria-live="polite"></p>

                <button type="submit" class="ripple-host">@T["ContactSendMessage"]</button>
            </form>
        </div>
    </div>
</section>
