@model MamiaSeedsOil.Web.ViewModels.HomePageViewModel

@{
    var phoneEntries = (Model.Company.Phone ?? string.Empty)
        .Split(['/', ';', ','], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Where(entry => !string.IsNullOrWhiteSpace(entry))
        .ToList();
}

<section class="contact-section" id="contact" aria-labelledby="contact-title">
    <div class="wrap contact-grid">
        <div class="contact-info">
            <span class="eyebrow">@Model.Contact.Eyebrow</span>
            <h2 class="contact-title" id="contact-title">@Model.Contact.Title</h2>
            <div class="item">
                <h3>Address</h3>
                <p>@Model.Company.AddressLine1,<br>@Model.Company.AddressLine2</p>
            </div>
            <div class="item">
                <h3>Phone / WhatsApp</h3>
                @foreach (var phone in phoneEntries)
                {
                    var phoneHref = phone.Replace(" ", string.Empty);
                    <p><a href="tel:@phoneHref" aria-label="@($"Call {Model.Company.Name}")">@phone</a></p>
                }
            </div>
            <div class="item">
                <h3>Email</h3>
                <p><a href="mailto:@Model.Company.Email" aria-label="@($"Email {Model.Company.Name}")">@Model.Company.Email</a></p>
            </div>
            <div class="item">
                <h3>Business Hours</h3>
                <p>@Model.Company.BusinessHours</p>
            </div>
        </div>
        <div>
            <form class="contact-form" data-contact-form data-success-message="@Model.Contact.FormSuccessMessage" data-submitting-message="Submitting your message..." data-failed-message="We could not send your message right now. Please try again." aria-label="Contact form">
                <label class="sr-only" for="full-name">Full Name</label>
                <input id="full-name" name="fullName" type="text" placeholder="Full Name" autocomplete="name" required>

                <label class="sr-only" for="company-name">Company</label>
                <input id="company-name" name="company" type="text" placeholder="Company" autocomplete="organization">

                <label class="sr-only" for="email-address">Email Address</label>
                <input id="email-address" name="email" type="email" placeholder="Email Address" autocomplete="email" required>

                <label class="sr-only" for="phone-number">Phone Number</label>
                <input id="phone-number" name="phone" type="tel" placeholder="Phone Number" autocomplete="tel">

                <label class="sr-only" for="requirements">Requirements</label>
                <textarea id="requirements" name="requirements" rows="4" placeholder="Requirements"></textarea>

                <p class="form-status" data-form-status aria-live="polite"></p>

                <button type="submit" class="ripple-host">Send Message</button>
            </form>
        </div>
    </div>
</section>
