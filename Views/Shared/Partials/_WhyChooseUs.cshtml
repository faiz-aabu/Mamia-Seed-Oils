@model MamiaSeedsOil.Web.ViewModels.WhyChooseUsViewModel

<section class="surface-paper" id="why-mamia" aria-labelledby="why-mamia-title">
    <div class="wrap">
        <div class="section-head">
            <span class="eyebrow">@Model.Eyebrow</span>
            <h2 id="why-mamia-title">@Model.Title</h2>
            <p>@Model.Description</p>
        </div>
        <div class="cards-grid-3">
            @foreach (var card in Model.Items)
            {
                <article class="feature-card">
                    <div class="card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8" stroke="#8C5A2B" stroke-width="1.8" /><path d="M8.5 12l2.2 2.2L15.5 9.5" stroke="#8C5A2B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></div>
                    <h3>@card.Title</h3>
                    <p>@card.Description</p>
                </article>
            }
        </div>
    </div>
</section>
