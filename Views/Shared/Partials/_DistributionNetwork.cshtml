@model MamiaSeedsOil.Web.ViewModels.DistributionViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<MamiaSeedsOil.Web.Resources.SharedResource> T

@{
    var placeholders = ViewData["AssetPlaceholders"] as System.Collections.Generic.IReadOnlyDictionary<string, MamiaSeedsOil.Web.ViewModels.PlaceholderAssetViewModel>;
    MamiaSeedsOil.Web.ViewModels.PlaceholderAssetViewModel? distributionPlaceholder = null;
    placeholders?.TryGetValue("distributionTrucks", out distributionPlaceholder);
}

<section class="surface-cream" id="distribution" aria-labelledby="distribution-title">
    <div class="wrap">
        <div class="section-head">
            <span class="eyebrow">@Model.Eyebrow</span>
            <h2 id="distribution-title">@Model.Title</h2>
            <p>@Model.Description</p>
        </div>
        <div class="distribution-grid">
            <div class="map-placeholder-pro skeleton" aria-label="@T["DistributionMapPlaceholderAria"]">
                <div class="map-center">
                    <svg viewBox="0 0 90 90" fill="none" aria-hidden="true"><path d="M20 22 46 12l22 8 8 26-8 28-25 6-22-12-7-22 6-24Z" stroke="#8C5A2B" stroke-width="2.2" /><circle cx="45" cy="45" r="4" fill="#8C5A2B" /></svg>
                    <strong>@Model.MapPlaceholderTitle</strong>
                    <span>@Model.MapPlaceholderDescription</span>
                    @if (distributionPlaceholder is not null)
                    {
                        <small class="map-note">@distributionPlaceholder.Label - @distributionPlaceholder.SubLabel</small>
                    }
                </div>
            </div>
            <div class="region-grid">
                @foreach (var region in Model.Regions)
                {
                    <article class="region-card">
                        <h3>@region.Title</h3>
                        <p>@region.Description</p>
                    </article>
                }
            </div>
        </div>
    </div>
</section>
