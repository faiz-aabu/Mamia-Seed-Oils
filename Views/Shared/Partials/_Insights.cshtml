@model MamiaSeedsOil.Web.ViewModels.InsightSectionViewModel

<section class="surface-paper" id="insights" aria-labelledby="insights-title">
    <div class="wrap">
        <div class="section-head">
            <span class="eyebrow">@Model.Eyebrow</span>
            <h2 id="insights-title">@Model.Title</h2>
            <p>@Model.Description</p>
        </div>
        <div class="cards-grid-3">
            @foreach (var item in Model.Items)
            {
                <article class="insight-card">
                    @await Html.PartialAsync("Partials/_ResponsiveImage", new MamiaSeedsOil.Web.ViewModels.ResponsiveImageViewModel
                    {
                        Alt = $"{item.Title} placeholder image",
                        Width = 1200,
                        Height = 675,
                        Sizes = "(max-width: 900px) 100vw, 33vw",
                        CssClass = "insight-thumb",
                        PlaceholderKey = "documents",
                        UsePlaceholder = true
                    })
                    <div class="insight-meta">@item.Category</div>
                    <h3>@item.Title</h3>
                    <p>@item.Description</p>
                    <a class="insight-link" href="@item.Url">@item.LinkText</a>
                </article>
            }
        </div>
    </div>
</section>
