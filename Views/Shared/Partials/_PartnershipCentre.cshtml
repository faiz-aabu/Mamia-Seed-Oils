@model MamiaSeedsOil.Web.ViewModels.HomePageViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<MamiaSeedsOil.Web.Resources.SharedResource> T

<section class="surface-cream" id="partnership-center" aria-labelledby="partnership-center-title">
    <div class="wrap">
        <div class="section-head">
            <span class="eyebrow">@Model.PartnershipCentre.Eyebrow</span>
            <h2 id="partnership-center-title">@Model.PartnershipCentre.Title</h2>
            <p>@Model.PartnershipCentre.Description</p>
        </div>

        <div class="partnership-partners" aria-label="@T["PartnershipPartnerTypesAria"]">
            @foreach (var partner in Model.PartnershipCentre.PartnerTypes)
            {
                <span class="partnership-chip">@partner</span>
            }
        </div>

        <div class="cards-grid-3 partnership-pillars" aria-label="@T["PartnershipPillarsAria"]">
            @foreach (var pillar in Model.PartnershipCentre.Pillars)
            {
                <article class="feature-card">
                    <h3>@pillar.Title</h3>
                    <p>@pillar.Description</p>
                </article>
            }
        </div>

        <div class="partnership-grid">
            <div class="partnership-support-box" aria-label="@T["PartnershipDocumentsAria"]">
                <h3>@T["PartnershipFutureDocumentsTitle"]</h3>
                <p>@T["PartnershipFutureDocumentsDescription"]</p>
                <ul>
                    @foreach (var document in Model.PartnershipCentre.DocumentRequirements)
                    {
                        <li>
                            <strong>@document.DocumentType</strong>
                            <span>@document.Description</span>
                            <small>@(document.IsRequired ? T["PartnershipDocumentRequired"] : T["PartnershipDocumentOptional"])</small>
                        </li>
                    }
                </ul>
            </div>

            <div class="partnership-whatsapp-box" aria-label="@T["PartnershipWhatsAppAria"]">
                <h3>@T["PartnershipWhatsAppTitle"]</h3>
                <p>@T["PartnershipWhatsAppDescription"]</p>
                @if (!string.IsNullOrWhiteSpace(Model.PartnershipCentre.WhatsAppConversationUrl))
                {
                    <a class="btn-primary ripple-host" href="@Model.PartnershipCentre.WhatsAppConversationUrl" target="_blank" rel="noopener noreferrer">@T["PartnershipWhatsAppButton"]</a>
                }
                else
                {
                    <span class="partnership-whatsapp-placeholder">@T["PartnershipWhatsAppUnavailable"]</span>
                }
            </div>
        </div>

          <form class="partnership-form"
              data-partnership-form
              data-endpoint="/api/partnership/applications"
              data-success-message="@Model.PartnershipCentre.FormSuccessMessage"
              data-submitting-message="@Model.PartnershipCentre.FormSubmittingMessage"
              data-failed-message="@Model.PartnershipCentre.FormErrorMessage"
              data-review-company-name="@T["PartnershipReviewCompanyName"]"
              data-review-business-registration-number="@T["PartnershipReviewBusinessRegistrationNumber"]"
              data-review-contact-person="@T["PartnershipReviewContactPerson"]"
              data-review-position="@T["PartnershipReviewPosition"]"
              data-review-phone-number="@T["PartnershipReviewPhoneNumber"]"
              data-review-email-address="@T["PartnershipReviewEmailAddress"]"
              data-review-business-address="@T["PartnershipReviewBusinessAddress"]"
              data-review-country="@T["PartnershipReviewCountry"]"
              data-review-state="@T["PartnershipReviewState"]"
              data-review-city="@T["PartnershipReviewCity"]"
              data-review-business-type="@T["PartnershipReviewBusinessType"]"
              data-review-years-in-operation="@T["PartnershipReviewYearsInOperation"]"
              data-review-monthly-purchase-estimate="@T["PartnershipReviewMonthlyPurchaseEstimate"]"
              data-review-preferred-products="@T["PartnershipReviewPreferredProducts"]"
              data-review-preferred-packaging="@T["PartnershipReviewPreferredPackaging"]"
              data-review-additional-notes="@T["PartnershipReviewAdditionalNotes"]"
              data-review-unavailable="@T["PartnershipReviewUnavailable"]"
              aria-label="@T["PartnershipFormAria"]">
            <input type="text" name="spamTrap" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true">
            <input type="hidden" name="formStartedAtUtc" data-form-started-at>

            <ol class="partnership-steps" aria-label="@T["PartnershipStepsAria"]">
                <li data-step-indicator aria-current="step">@T["PartnershipStepBusinessInfo"]</li>
                <li data-step-indicator>@T["PartnershipStepContactInfo"]</li>
                <li data-step-indicator>@T["PartnershipStepRequirements"]</li>
                <li data-step-indicator>@T["PartnershipStepReview"]</li>
                <li data-step-indicator>@T["PartnershipStepSubmit"]</li>
            </ol>

            <fieldset data-step-panel>
                <legend>@T["PartnershipStepBusinessInfo"]</legend>
                <label for="pa-company-name">@T["PartnershipFieldCompanyName"]</label>
                <input id="pa-company-name" name="companyName" type="text" required maxlength="180" autocomplete="organization">

                <label for="pa-reg-number">@T["PartnershipFieldRegistrationNumber"]</label>
                <input id="pa-reg-number" name="businessRegistrationNumber" type="text" maxlength="120">

                <label for="pa-business-type">@T["PartnershipFieldBusinessType"]</label>
                <select id="pa-business-type" name="businessType" required>
                    <option value="">@T["PartnershipSelectPlaceholder"]</option>
                    @foreach (var option in Model.PartnershipCentre.BusinessTypeOptions)
                    {
                        <option value="@option.Value">@option.Label</option>
                    }
                </select>

                <label for="pa-years-operation">@T["PartnershipFieldYearsInOperation"]</label>
                <select id="pa-years-operation" name="yearsInOperation">
                    <option value="">@T["PartnershipSelectPlaceholder"]</option>
                    @foreach (var option in Model.PartnershipCentre.YearsInOperationOptions)
                    {
                        <option value="@option.Value">@option.Label</option>
                    }
                </select>

                <label for="pa-business-address">@T["PartnershipFieldBusinessAddress"]</label>
                <textarea id="pa-business-address" name="businessAddress" rows="3" maxlength="300"></textarea>
            </fieldset>

            <fieldset data-step-panel hidden>
                <legend>@T["PartnershipStepContactInfo"]</legend>
                <label for="pa-contact-person">@T["PartnershipFieldContactPerson"]</label>
                <input id="pa-contact-person" name="contactPerson" type="text" required maxlength="120" autocomplete="name">

                <label for="pa-position">@T["PartnershipFieldPosition"]</label>
                <input id="pa-position" name="position" type="text" maxlength="120" autocomplete="organization-title">

                <label for="pa-phone-number">@T["PartnershipFieldPhone"]</label>
                <input id="pa-phone-number" name="phoneNumber" type="tel" required maxlength="60" autocomplete="tel">

                <label for="pa-email-address">@T["PartnershipFieldEmail"]</label>
                <input id="pa-email-address" name="emailAddress" type="email" required maxlength="180" autocomplete="email">

                <label for="pa-country">@T["PartnershipFieldCountry"]</label>
                <input id="pa-country" name="country" type="text" required maxlength="80" autocomplete="country-name">

                <label for="pa-state">@T["PartnershipFieldState"]</label>
                <input id="pa-state" name="state" type="text" required maxlength="80" autocomplete="address-level1">

                <label for="pa-city">@T["PartnershipFieldCity"]</label>
                <input id="pa-city" name="city" type="text" required maxlength="80" autocomplete="address-level2">
            </fieldset>

            <fieldset data-step-panel hidden>
                <legend>@T["PartnershipStepRequirements"]</legend>
                <label for="pa-monthly-estimate">@T["PartnershipFieldMonthlyEstimate"]</label>
                <input id="pa-monthly-estimate" name="monthlyPurchaseEstimate" type="text" required maxlength="120">

                <label for="pa-preferred-products">@T["PartnershipFieldPreferredProducts"]</label>
                <select id="pa-preferred-products" name="preferredProducts" multiple size="4" aria-describedby="pa-products-help">
                    @foreach (var option in Model.PartnershipCentre.PreferredProductOptions)
                    {
                        <option value="@option.Value">@option.Label</option>
                    }
                </select>
                <small id="pa-products-help">@T["PartnershipMultiSelectHelp"]</small>

                <label for="pa-preferred-packaging">@T["PartnershipFieldPreferredPackaging"]</label>
                <select id="pa-preferred-packaging" name="preferredPackaging" multiple size="4" aria-describedby="pa-packaging-help">
                    @foreach (var option in Model.PartnershipCentre.PreferredPackagingOptions)
                    {
                        <option value="@option.Value">@option.Label</option>
                    }
                </select>
                <small id="pa-packaging-help">@T["PartnershipMultiSelectHelp"]</small>

                <label for="pa-additional-notes">@T["PartnershipFieldAdditionalNotes"]</label>
                <textarea id="pa-additional-notes" name="additionalNotes" rows="4" maxlength="2000"></textarea>
            </fieldset>

            <fieldset data-step-panel hidden>
                <legend>@T["PartnershipStepReview"]</legend>
                <div class="partnership-review" data-partnership-review></div>
                <label class="partnership-terms">
                    <input type="checkbox" name="agreedToTerms" value="true" required>
                    <span>@T["PartnershipAgreeTermsPrefix"] <a href="@Model.PartnershipCentre.TermsUrl">@T["PartnershipAgreeTermsLink"]</a>.</span>
                </label>
            </fieldset>

            <fieldset data-step-panel hidden>
                <legend>@T["PartnershipStepSubmit"]</legend>
                <p>@T["PartnershipSubmitDescription"]</p>
                <p class="form-status" data-partnership-status aria-live="polite"></p>
            </fieldset>

            <div class="partnership-actions">
                <button type="button" class="btn-ghost" data-partnership-back hidden>@T["PartnershipBack"]</button>
                <button type="button" class="btn-primary" data-partnership-next>@T["PartnershipNext"]</button>
                <button type="submit" class="btn-primary" data-partnership-submit hidden>@T["PartnershipSubmit"]</button>
            </div>
        </form>
    </div>
</section>
