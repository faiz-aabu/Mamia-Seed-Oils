@model MamiaSeedsOil.Web.ViewModels.HomePageViewModel

<section class="surface-cream" id="partnership-center" aria-labelledby="partnership-center-title">
    <div class="wrap">
        <div class="section-head">
            <span class="eyebrow">@Model.PartnershipCentre.Eyebrow</span>
            <h2 id="partnership-center-title">@Model.PartnershipCentre.Title</h2>
            <p>@Model.PartnershipCentre.Description</p>
        </div>

        <div class="partnership-partners" aria-label="Partner types">
            @foreach (var partner in Model.PartnershipCentre.PartnerTypes)
            {
                <span class="partnership-chip">@partner</span>
            }
        </div>

        <div class="cards-grid-3 partnership-pillars" aria-label="Partnership pillars">
            @foreach (var pillar in Model.PartnershipCentre.Pillars)
            {
                <article class="feature-card">
                    <h3>@pillar.Title</h3>
                    <p>@pillar.Description</p>
                </article>
            }
        </div>

        <div class="partnership-grid">
            <div class="partnership-support-box" aria-label="Document requirements">
                <h3>Required Business Documents</h3>
                <p>Prepare the business details and supporting documents below for a faster review.</p>
                <ul>
                    @foreach (var document in Model.PartnershipCentre.DocumentRequirements)
                    {
                        <li>
                            <strong>@document.DocumentType</strong>
                            <span>@document.Description</span>
                            <small>@(document.IsRequired ? "Required" : "Optional")</small>
                        </li>
                    }
                </ul>
            </div>

            <div class="partnership-whatsapp-box" aria-label="WhatsApp support">
                <h3>WhatsApp Support</h3>
                <p>Start a direct conversation with our team if you need help before submitting.</p>
                @if (!string.IsNullOrWhiteSpace(Model.PartnershipCentre.WhatsAppConversationUrl))
                {
                    <a class="btn-primary ripple-host" href="@Model.PartnershipCentre.WhatsAppConversationUrl" target="_blank" rel="noopener noreferrer">Chat on WhatsApp</a>
                }
                else
                {
                    <span class="partnership-whatsapp-placeholder">WhatsApp support is not available right now.</span>
                }
            </div>
        </div>

          <form class="partnership-form"
              data-partnership-form
              data-endpoint="/api/partnership/applications"
              data-success-message="@Model.PartnershipCentre.FormSuccessMessage"
              data-submitting-message="@Model.PartnershipCentre.FormSubmittingMessage"
              data-failed-message="@Model.PartnershipCentre.FormErrorMessage"
              data-review-company-name="Company Name"
              data-review-business-registration-number="Business Registration Number"
              data-review-contact-person="Contact Person"
              data-review-position="Position"
              data-review-phone-number="Phone Number"
              data-review-email-address="Email Address"
              data-review-business-address="Business Address"
              data-review-country="Country"
              data-review-state="State"
              data-review-city="City"
              data-review-business-type="Business Type"
              data-review-years-in-operation="Years in Operation"
              data-review-monthly-purchase-estimate="Monthly Purchase Estimate"
              data-review-preferred-products="Preferred Products"
              data-review-preferred-packaging="Preferred Packaging"
              data-review-additional-notes="Additional Notes"
              data-review-unavailable="Not provided"
              aria-label="Distributor application form">
            <input type="text" name="spamTrap" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true">
            <input type="hidden" name="formStartedAtUtc" data-form-started-at>

            <ol class="partnership-steps" aria-label="Application steps">
                <li data-step-indicator aria-current="step">Business Info</li>
                <li data-step-indicator>Contact Info</li>
                <li data-step-indicator>Requirements</li>
                <li data-step-indicator>Review</li>
                <li data-step-indicator>Submit</li>
            </ol>

            <fieldset data-step-panel>
                <legend>Business Info</legend>
                <label for="pa-company-name">Company Name</label>
                <input id="pa-company-name" name="companyName" type="text" required maxlength="180" autocomplete="organization">

                <label for="pa-reg-number">Business Registration Number</label>
                <input id="pa-reg-number" name="businessRegistrationNumber" type="text" maxlength="120">

                <label for="pa-business-type">Business Type</label>
                <select id="pa-business-type" name="businessType" required>
                    <option value="">Select an option</option>
                    @foreach (var option in Model.PartnershipCentre.BusinessTypeOptions)
                    {
                        <option value="@option.Value">@option.Label</option>
                    }
                </select>

                <label for="pa-years-operation">Years in Operation</label>
                <select id="pa-years-operation" name="yearsInOperation">
                    <option value="">Select an option</option>
                    @foreach (var option in Model.PartnershipCentre.YearsInOperationOptions)
                    {
                        <option value="@option.Value">@option.Label</option>
                    }
                </select>

                <label for="pa-business-address">Business Address</label>
                <textarea id="pa-business-address" name="businessAddress" rows="3" maxlength="300"></textarea>
            </fieldset>

            <fieldset data-step-panel hidden>
                <legend>Contact Info</legend>
                <label for="pa-contact-person">Contact Person</label>
                <input id="pa-contact-person" name="contactPerson" type="text" required maxlength="120" autocomplete="name">

                <label for="pa-position">Position</label>
                <input id="pa-position" name="position" type="text" maxlength="120" autocomplete="organization-title">

                <label for="pa-phone-number">Phone Number</label>
                <input id="pa-phone-number" name="phoneNumber" type="tel" required maxlength="60" autocomplete="tel">

                <label for="pa-email-address">Email Address</label>
                <input id="pa-email-address" name="emailAddress" type="email" required maxlength="180" autocomplete="email">

                <label for="pa-country">Country</label>
                <input id="pa-country" name="country" type="text" required maxlength="80" autocomplete="country-name">

                <label for="pa-state">State</label>
                <input id="pa-state" name="state" type="text" required maxlength="80" autocomplete="address-level1">

                <label for="pa-city">City</label>
                <input id="pa-city" name="city" type="text" required maxlength="80" autocomplete="address-level2">
            </fieldset>

            <fieldset data-step-panel hidden>
                <legend>Requirements</legend>
                <label for="pa-monthly-estimate">Monthly Purchase Estimate</label>
                <input id="pa-monthly-estimate" name="monthlyPurchaseEstimate" type="text" required maxlength="120">

                <label for="pa-preferred-products">Preferred Products</label>
                <select id="pa-preferred-products" name="preferredProducts" multiple size="4" aria-describedby="pa-products-help">
                    @foreach (var option in Model.PartnershipCentre.PreferredProductOptions)
                    {
                        <option value="@option.Value">@option.Label</option>
                    }
                </select>
                <small id="pa-products-help">Hold Ctrl or Command to select more than one option.</small>

                <label for="pa-preferred-packaging">Preferred Packaging</label>
                <select id="pa-preferred-packaging" name="preferredPackaging" multiple size="4" aria-describedby="pa-packaging-help">
                    @foreach (var option in Model.PartnershipCentre.PreferredPackagingOptions)
                    {
                        <option value="@option.Value">@option.Label</option>
                    }
                </select>
                <small id="pa-packaging-help">Hold Ctrl or Command to select more than one option.</small>

                <label for="pa-additional-notes">Additional Notes</label>
                <textarea id="pa-additional-notes" name="additionalNotes" rows="4" maxlength="2000"></textarea>
            </fieldset>

            <fieldset data-step-panel hidden>
                <legend>Review</legend>
                <div class="partnership-review" data-partnership-review></div>
                <label class="partnership-terms">
                    <input type="checkbox" name="agreedToTerms" value="true" required>
                    <span>I agree to the <a href="@Model.PartnershipCentre.TermsUrl">terms and conditions</a>.</span>
                </label>
            </fieldset>

            <fieldset data-step-panel hidden>
                <legend>Submit</legend>
                <p>Review your details and submit your distributor application.</p>
                <p class="form-status" data-partnership-status aria-live="polite"></p>
            </fieldset>

            <div class="partnership-actions">
                <button type="button" class="btn-ghost" data-partnership-back hidden>Back</button>
                <button type="button" class="btn-primary" data-partnership-next>Next</button>
                <button type="submit" class="btn-primary" data-partnership-submit hidden>Submit</button>
            </div>
        </form>
    </div>
</section>
