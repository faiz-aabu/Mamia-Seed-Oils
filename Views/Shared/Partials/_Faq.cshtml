@model MamiaSeedsOil.Web.ViewModels.FaqSectionViewModel

<section class="surface-paper" id="faq" aria-labelledby="faq-title">
    <div class="wrap">
        <div class="section-head">
            <span class="eyebrow">@Model.Eyebrow</span>
            <h2 id="faq-title">@Model.Title</h2>
        </div>
        <div class="faq-list" data-accordion>
            @for (var i = 0; i < Model.Items.Count; i++)
            {
                var item = Model.Items[i];
                var panelId = $"faq-panel-{i}";
                var buttonId = $"faq-trigger-{i}";
                <article class="faq-item">
                    <button class="faq-trigger" type="button" id="@buttonId" aria-expanded="false" aria-controls="@panelId"><span>@item.Question</span><span>+</span></button>
                    <div class="faq-panel" id="@panelId" role="region" aria-labelledby="@buttonId"><p>@item.Answer</p></div>
                </article>
            }
        </div>
    </div>
</section>
