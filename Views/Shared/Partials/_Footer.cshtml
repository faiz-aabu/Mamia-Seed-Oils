@model MamiaSeedsOil.Web.ViewModels.HomePageViewModel

<footer class="footer-premium">
    <div class="wrap">
        <div class="footer-grid-premium">
            <div>
                <a class="footer-brand-link" href="#top" aria-label="@Model.Company.Name home">
                    <img class="footer-brand-mark"
                         src="~/images/logo/Logo.png"
                         alt=""
                         width="36"
                         height="36"
                         loading="lazy"
                         decoding="async"
                         asp-append-version="true" />
                    <span class="footer-brand">@Model.Company.Name</span>
                </a>
                <p class="footer-copy">@Model.Footer.Description</p>
                <form class="footer-newsletter" data-newsletter-form data-success-message="@Model.Footer.NewsletterSuccessMessage" data-default-success-message="Thanks for subscribing." aria-label="Newsletter form">
                    <input type="email" placeholder="@Model.Footer.NewsletterPlaceholder" aria-label="Newsletter email address">
                    <button type="submit" class="ripple-host">@Model.Footer.NewsletterButtonText</button>
                </form>
            </div>
            @foreach (var column in Model.Footer.Columns)
            {
                <div class="footer-col">
                    <h4>@column.Heading</h4>
                    <ul>
                        @foreach (var link in column.Links)
                        {
                            var isInstagramLink = link.Url.Contains("instagram.com", StringComparison.OrdinalIgnoreCase);
                            <li><a href="@link.Url"@((isInstagramLink ? " target=\"_blank\" rel=\"noopener noreferrer\"" : string.Empty))>@link.Text</a></li>
                        }
                    </ul>
                </div>
            }
            <div class="footer-col footer-col--digital">
                <h4>DIGITAL SOLUTIONS</h4>
                <p class="footer-col__intro">Need a professional website, AI assistant, or custom business system?</p>
                <p class="footer-col__intro footer-col__intro--secondary">We build modern digital solutions that help businesses establish a strong online presence, improve operations, and grow with technology.</p>
                <ul class="footer-col__service-links">
                    <li><a href="https://wa.me/2348022788553" target="_blank" rel="noopener noreferrer">📱 WhatsApp</a></li>
                    <li><a href="tel:+2348022788553">📞 Call</a></li>
                    <li><a href="#">📷 Instagram</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="footer-bottom__meta">
                <span>@Model.Footer.Copyright</span>
                <a class="footer-credit" href="https://wa.me/2348022788553" target="_blank" rel="noopener noreferrer">Website designed and maintained by Faiz Digital Solutions.</a>
            </div>
            <a class="back-top ripple-host" href="#top" aria-label="Back to top">↑</a>
        </div>
    </div>
</footer>
