@model MamiaSeedsOil.Web.ViewModels.HistoryViewModel

<section class="history" id="history" aria-labelledby="history-title">
    <div class="wrap history-grid">
        <div>
            <h2 id="history-title" class="eyebrow">@Model.Eyebrow</h2>
            <div class="history-timeline">
                @foreach (var timeline in Model.Timeline)
                {
                    <div class="tl-item">
                        <div class="tl-year">@timeline.Title</div>
                        <p>@timeline.Description</p>
                    </div>
                }
            </div>
        </div>
        <div class="history-copy">
            <span class="eyebrow">@Model.SubEyebrow</span>
            <p class="history-intro">@Model.Intro</p>
            @foreach (var paragraph in Model.Paragraphs.Take(2))
            {
                <p>@paragraph</p>
            }
        </div>
    </div>
</section>
