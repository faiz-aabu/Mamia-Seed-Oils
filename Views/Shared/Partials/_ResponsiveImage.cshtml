@model MamiaSeedsOil.Web.ViewModels.ResponsiveImageViewModel
@inject MamiaSeedsOil.Web.Interfaces.IImageUrlService ImageUrlService

@{
    var placeholders = ViewData["AssetPlaceholders"] as System.Collections.Generic.IReadOnlyDictionary<string, MamiaSeedsOil.Web.ViewModels.PlaceholderAssetViewModel>;
    MamiaSeedsOil.Web.ViewModels.PlaceholderAssetViewModel? placeholder = null;
    var hasPlaceholder = !string.IsNullOrWhiteSpace(Model.PlaceholderKey) && placeholders is not null && placeholders.TryGetValue(Model.PlaceholderKey, out placeholder);
    var imageAlt = string.IsNullOrWhiteSpace(Model.Alt) ? "Mamia Seeds Oil image placeholder" : Model.Alt;
    var resolvedSrc = ImageUrlService.ResolveUrl(Model.Src);
    var resolvedWebpSrc = ImageUrlService.ResolveUrl(Model.WebpSrc);
}

@if (!Model.UsePlaceholder && !string.IsNullOrWhiteSpace(resolvedSrc))
{
    <picture class="@Model.CssClass image-frame">
        @if (!string.IsNullOrWhiteSpace(resolvedWebpSrc))
        {
            <source type="image/webp" srcset="@resolvedWebpSrc" />
        }
        <img src="@resolvedSrc"
             alt="@imageAlt"
             loading="lazy"
             decoding="async"
             width="@Model.Width"
             height="@Model.Height"
             sizes="@ImageUrlService.ResolveSizes(Model.Sizes)"
             data-blur="@ImageUrlService.ResolveBlurPlaceholder()" />
    </picture>
}
else if (hasPlaceholder)
{
    <div class="image-frame image-frame--placeholder">
        @await Html.PartialAsync("Partials/_AssetPlaceholder", placeholder)
    </div>
}
else
{
    <div class="image-frame image-frame--placeholder" role="img" aria-label="@imageAlt" data-placeholder-key="generic">
        <div class="asset-placeholder" style="--asset-ratio:4 / 3;" data-placeholder-key="generic">
            <span class="asset-placeholder-label">Image Placeholder</span>
            <small class="asset-placeholder-sub">Professional image coming soon</small>
        </div>
    </div>
}
