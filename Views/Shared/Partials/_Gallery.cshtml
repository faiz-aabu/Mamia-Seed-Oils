@model MamiaSeedsOil.Web.ViewModels.GalleryViewModel

@{
    var placeholders = ViewData["AssetPlaceholders"] as System.Collections.Generic.IReadOnlyDictionary<string, MamiaSeedsOil.Web.ViewModels.PlaceholderAssetViewModel>;
    MamiaSeedsOil.Web.ViewModels.PlaceholderAssetViewModel? galleryPlaceholder = null;
    placeholders?.TryGetValue("factoryImages", out galleryPlaceholder);
    var galleryItems = Model.Items.Take(8).ToList();
}

<section id="gallery" aria-labelledby="gallery-title">
    <div class="wrap">
        <div class="section-head">
            <span class="eyebrow">@Model.Eyebrow</span>
            <h2 id="gallery-title">@Model.Title</h2>
            <p>@Model.Description</p>
        </div>
        <div class="gallery-grid">
            @for (var index = 0; index < galleryItems.Count; index++)
            {
                var item = galleryItems[index];
                var placeholderPath = index switch
                {
                    0 => "/images/factory/factory-exterior-placeholder.svg",
                    1 => "/images/factory/production-line-placeholder.svg",
                    2 => "/images/factory/soybean-processing-placeholder.svg",
                    3 => "/images/factory/bottling-line-placeholder.svg",
                    4 => "/images/factory/warehouse-placeholder.svg",
                    5 => "/images/factory/delivery-trucks-placeholder.svg",
                    _ => "/images/gallery/gallery-image-placeholder.svg"
                };

                <article class="gallery-item @item.Key" aria-label="@item.Title">
                    <img src="@placeholderPath"
                         alt="@item.Title placeholder image"
                         loading="lazy"
                         decoding="async"
                         width="1200"
                         height="900" />
                    <div class="gallery-item-overlay">
                        <span class="gallery-item-label">@item.Title</span>
                        <small>@(galleryPlaceholder?.SubLabel ?? "Professional image placeholder")</small>
                    </div>
                </article>
            }
        </div>
    </div>
</section>
