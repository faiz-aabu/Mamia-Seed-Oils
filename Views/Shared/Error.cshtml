@model ErrorViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">An error occurred.</h1>
<h2 class="text-danger">We could not process your request.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

@if (Env.IsDevelopment())
{
    <h3>Development mode</h3>
    <p>
        Switching to the Development environment will show more detailed information about this error.
    </p>
    <p>
        The Development environment should not be enabled for deployed applications because detailed error information can be exposed to end users.
    </p>
}
