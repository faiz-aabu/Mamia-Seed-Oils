@model MamiaSeedsOil.Web.ViewModels.AiAssistantWidgetViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<MamiaSeedsOil.Web.Resources.SharedResource> T

@if (Model.Enabled)
{
    <div class="ai-widget"
         data-ai-widget
         data-chat-endpoint="@Model.ChatEndpoint"
         data-suggestions-endpoint="@Model.SuggestionsEndpoint"
         data-fallback-error-message="@T["AiUnknownResponse"]"
         data-now-label="@T["AiNow"]"
         data-typing-label="@T["AiTyping"]">
        <button type="button" class="ai-fab ripple-host" aria-label="@T["AiOpenAssistant"]" data-ai-open>
            <span class="ai-fab-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="img" focusable="false">
                    <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8A2.5 2.5 0 0 1 17.5 16H9l-4.6 3.2c-.66.46-1.4-.02-1.4-.82V5.5Zm4.2 2.9a1.1 1.1 0 1 0 0 2.2 1.1 1.1 0 0 0 0-2.2Zm3.8 0a1.1 1.1 0 1 0 0 2.2 1.1 1.1 0 0 0 0-2.2Zm3.8 0a1.1 1.1 0 1 0 0 2.2 1.1 1.1 0 0 0 0-2.2Z"></path>
                </svg>
            </span>
            <span class="ai-fab-label">@T["AiFabLabel"]</span>
        </button>

        <section class="ai-panel" aria-live="polite" aria-label="@Model.DisplayName">
            <header class="ai-panel-header">
                <div>
                    <strong>@Model.DisplayName</strong>
                    <span>@T["AiBusinessAssistant"]</span>
                </div>
                <div class="ai-header-actions">
                    <button type="button" class="ai-control" aria-label="@T["AiMinimizeAssistant"]" data-ai-minimize>-</button>
                    <button type="button" class="ai-control" aria-label="@T["AiCloseAssistant"]" data-ai-close>x</button>
                </div>
            </header>

            <div class="ai-messages" data-ai-messages>
                <article class="ai-message ai-message-assistant">
                    <div class="ai-bubble">@Model.WelcomeMessage</div>
                    <time class="ai-time">@T["AiNow"]</time>
                </article>

                <div class="ai-typing" data-ai-typing hidden aria-live="polite">
                    <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
                    <small>@T["AiTyping"]</small>
                </div>
            </div>

            <div class="ai-suggestions" data-ai-suggestions>
                @foreach (var suggestion in Model.SuggestedQuestions)
                {
                    <button type="button" class="ai-suggestion" data-ai-suggestion="@suggestion">@suggestion</button>
                }
            </div>

            <form class="ai-input-wrap" data-ai-form>
                <textarea maxlength="800" required placeholder="@T["AiInputPlaceholder"]" data-ai-input rows="1"></textarea>
                <button type="submit" class="ai-send ripple-host" aria-label="@T["AiSend"]">@T["AiSend"]</button>
            </form>
        </section>
    </div>
}
