@{
    ViewData["Title"] = "Scheduled maintenance";
    var homeUrl = Url.Action("Index", "Home") ?? "/";
}

<section class="surface-cream" style="min-height:70vh; display:flex; align-items:center;">
    <div class="wrap">
        <div class="section-head">
            <span class="eyebrow">Maintenance</span>
            <h2>Scheduled maintenance</h2>
            <p>We are performing maintenance right now. Please check back shortly.</p>
            <a class="btn-primary ripple-host" href="@homeUrl">Back to home</a>
        </div>
    </div>
</section>
