@{
    ViewData["Title"] = "Access denied";
    var homeUrl = Url.Action("Index", "Home") ?? "/";
}

<section class="surface-paper" style="min-height:70vh; display:flex; align-items:center;">
    <div class="wrap">
        <div class="section-head">
            <span class="eyebrow">403 Error</span>
            <h2>Access denied</h2>
            <p>You do not have permission to access this page.</p>
            <a class="btn-primary ripple-host" href="@homeUrl">Back to home</a>
        </div>
    </div>
</section>
