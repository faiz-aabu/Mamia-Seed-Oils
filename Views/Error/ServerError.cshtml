@{
    ViewData["Title"] = "Server error";
    var homeUrl = Url.Action("Index", "Home") ?? "/";
}

<section class="surface-cream" style="min-height:70vh; display:flex; align-items:center;">
    <div class="wrap">
        <div class="section-head">
            <span class="eyebrow">500 Error</span>
            <h2>Server error</h2>
            <p>Something went wrong on our side. Please try again later.</p>
            <a class="btn-primary ripple-host" href="@homeUrl">Back to home</a>
        </div>
    </div>
</section>
