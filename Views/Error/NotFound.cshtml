@{
    ViewData["Title"] = "Page not found";
    var homeUrl = Url.Action("Index", "Home") ?? "/";
}

<section class="surface-paper" style="min-height:70vh; display:flex; align-items:center;">
    <div class="wrap">
        <div class="section-head">
            <span class="eyebrow">404 Error</span>
            <h2>Page not found</h2>
            <p>The page you requested could not be found.</p>
            <a class="btn-primary ripple-host" href="@homeUrl">Back to home</a>
        </div>
    </div>
</section>
