@inject Microsoft.Extensions.Localization.IStringLocalizer<MamiaSeedsOil.Web.Resources.SharedResource> T
@{
    ViewData["Title"] = T["Error403Title"];
    var homeUrl = Url.Action("Index", "Home", new { culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName }) ?? "/";
}

<section class="surface-paper" style="min-height:70vh; display:flex; align-items:center;">
    <div class="wrap">
        <div class="section-head">
            <span class="eyebrow">@T["Error403Eyebrow"]</span>
            <h2>@T["Error403Title"]</h2>
            <p>@T["Error403Body"]</p>
            <a class="btn-primary ripple-host" href="@homeUrl">@T["ErrorBackHome"]</a>
        </div>
    </div>
</section>
