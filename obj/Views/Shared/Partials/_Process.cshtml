@model IReadOnlyList<MamiaSeedsOil.Web.ViewModels.SimpleCardViewModel>
@inject Microsoft.Extensions.Localization.IStringLocalizer<MamiaSeedsOil.Web.Resources.SharedResource> T

<section class="process" id="process" aria-labelledby="process-title">
    <div class="wrap">
        <div class="section-head">
            <span class="eyebrow">@T["ProcessEyebrow"]</span>
            <h2 id="process-title">@T["ProcessTitle"]</h2>
            <p>@T["ProcessDescription"]</p>
        </div>
        <div class="process-strip">
            @for (var i = 0; i < Model.Count; i++)
            {
                var step = Model[i];
                <div class="process-step">
                    <span class="p-num">@((i + 1).ToString("D2"))</span>
                    <h4>@step.Title</h4>
                    <p>@step.Description</p>
                </div>
            }
        </div>
    </div>
</section>
