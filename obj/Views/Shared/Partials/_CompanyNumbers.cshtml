@model MamiaSeedsOil.Web.ViewModels.CompanyStatsSectionViewModel

@{
    var placeholders = ViewData["AssetPlaceholders"] as System.Collections.Generic.IReadOnlyDictionary<string, MamiaSeedsOil.Web.ViewModels.PlaceholderAssetViewModel>;
    MamiaSeedsOil.Web.ViewModels.PlaceholderAssetViewModel? employeeCountPlaceholder = null;
    MamiaSeedsOil.Web.ViewModels.PlaceholderAssetViewModel? productionCapacityPlaceholder = null;
    placeholders?.TryGetValue("employeeCount", out employeeCountPlaceholder);
    placeholders?.TryGetValue("productionCapacity", out productionCapacityPlaceholder);
}

<section class="numbers-band" id="numbers" aria-labelledby="numbers-title">
    <div class="wrap">
        <div class="section-head">
            <span class="eyebrow">@Model.Eyebrow</span>
            <h2 id="numbers-title">@Model.Title</h2>
            <p>@Model.Description</p>
        </div>
        <div class="numbers-grid">
            @foreach (var stat in Model.Items)
            {
                var numericPart = new string(stat.Value.TakeWhile(char.IsDigit).ToArray());
                var suffix = stat.Value.Length > numericPart.Length ? stat.Value[numericPart.Length..] : string.Empty;
                var hasNumericCount = !string.IsNullOrWhiteSpace(numericPart);
                var isEmployeeLabel = stat.Label.Contains("Employee", StringComparison.OrdinalIgnoreCase);
                var isProductionLabel = stat.Label.Contains("Litre", StringComparison.OrdinalIgnoreCase) || stat.Label.Contains("Production", StringComparison.OrdinalIgnoreCase);
                <div class="number-tile">
                    @if (hasNumericCount)
                    {
                        <div class="number-value" data-count="@numericPart" data-suffix="@suffix">0</div>
                    }
                    else
                    {
                        <div class="number-value" data-static="@stat.Value">@stat.Value</div>
                        @if (isEmployeeLabel && employeeCountPlaceholder is not null)
                        {
                            <div class="number-note">@employeeCountPlaceholder.SubLabel</div>
                        }
                        @if (isProductionLabel && productionCapacityPlaceholder is not null)
                        {
                            <div class="number-note">@productionCapacityPlaceholder.SubLabel</div>
                        }
                    }
                    <div class="number-label">@stat.Label</div>
                </div>
            }
        </div>
    </div>
</section>
