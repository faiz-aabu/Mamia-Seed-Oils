@model MamiaSeedsOil.Web.ViewModels.CtaViewModel

<section class="corp-cta" aria-labelledby="corp-cta-title">
    <div class="wrap">
        <div class="section-head">
            <span class="eyebrow">@Model.Eyebrow</span>
            <h2 id="corp-cta-title">@Model.Title</h2>
            <p>@Model.Description</p>
            <div class="corp-cta-actions">
                <a class="btn-primary ripple-host" href="@Model.PrimaryButtonUrl">@Model.PrimaryButtonText</a>
                <a class="btn-ghost ripple-host" href="@Model.SecondaryButtonUrl">@Model.SecondaryButtonText</a>
            </div>
        </div>
    </div>
</section>
