@model IReadOnlyList<MamiaSeedsOil.Web.ViewModels.SimpleCardViewModel>
@inject Microsoft.Extensions.Localization.IStringLocalizer<MamiaSeedsOil.Web.Resources.SharedResource> T

<div class="trust-bar" aria-label="@T["TrustBarAria"]">
    <div class="wrap trust-row">
        @foreach (var badge in Model)
        {
            <div class="seal">
                <svg class="seal-icon" viewBox="0 0 48 48" fill="none" aria-hidden="true" focusable="false">
                    <circle cx="24" cy="24" r="22" stroke="#8C5A2B" stroke-width="2" />
                    <path d="M15 25l6 6 12-14" stroke="#8C5A2B" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <div class="seal-text">
                    <b>@badge.Title</b>
                    <span>@badge.Description</span>
                </div>
            </div>
        }
    </div>
</div>
