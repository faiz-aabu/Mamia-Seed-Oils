@model ErrorViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<MamiaSeedsOil.Web.Resources.SharedResource> T
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    ViewData["Title"] = T["SharedErrorTitle"];
}

<h1 class="text-danger">@T["SharedErrorHeading"]</h1>
<h2 class="text-danger">@T["SharedErrorBody"]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@T["SharedErrorRequestId"]</strong> <code>@Model.RequestId</code>
    </p>
}

@if (Env.IsDevelopment())
{
    <h3>@T["SharedErrorDevelopmentMode"]</h3>
    <p>
        @T["SharedErrorDevelopmentBody1"]
    </p>
    <p>
        @T["SharedErrorDevelopmentBody2"]
    </p>
}
