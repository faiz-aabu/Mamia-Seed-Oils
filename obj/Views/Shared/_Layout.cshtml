@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject Microsoft.Extensions.Options.IOptions<MamiaSeedsOil.Web.Configuration.AnalyticsOptions> AnalyticsOptions
@{
    var antiForgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var analytics = AnalyticsOptions.Value;
    var currentLanguage = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var hreflangLinks = ViewData["HreflangLinks"] as IReadOnlyList<KeyValuePair<string, string>>;
}

<!DOCTYPE html>
<html lang="@currentLanguage">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="@ViewData["SeoDescription"]" />
    <meta name="keywords" content="@ViewData["SeoKeywords"]" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="@ViewData["CanonicalUrl"]" />
    <link rel="icon" type="image/png" href="~/images/logo/Logo.png" asp-append-version="true" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="@(currentLanguage == "ha" ? "ha_NG" : "en_NG")" />
    <meta property="og:title" content="@ViewData["Title"]" />
    <meta property="og:description" content="@ViewData["SeoDescription"]" />
    <meta property="og:url" content="@ViewData["CanonicalUrl"]" />
    <meta property="og:image" content="@ViewData["OgImageUrl"]" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@ViewData["Title"]" />
    <meta name="twitter:description" content="@ViewData["SeoDescription"]" />
    <meta name="twitter:image" content="@ViewData["TwitterImageUrl"]" />
    <meta name="csrf-token" content="@antiForgeryToken" />

    @if (hreflangLinks is not null)
    {
        foreach (var entry in hreflangLinks)
        {
            <link rel="alternate" hreflang="@entry.Key" href="@entry.Value" />
        }
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Zilla+Slab:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Zilla+Slab:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navigation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hero.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sections.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/footer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ai-assistant.css" asp-append-version="true" />

    @if (ViewData["StructuredDataJsonLd"] is IReadOnlyList<string> schemas && schemas.Count > 0)
    {
        @foreach (var schema in schemas.Where(x => !string.IsNullOrWhiteSpace(x)))
        {
            <script type="application/ld+json">@Html.Raw(schema)</script>
        }
    }
    else if (ViewData["OrganizationJsonLd"] is string jsonLd && !string.IsNullOrWhiteSpace(jsonLd))
    {
        <script type="application/ld+json">@Html.Raw(jsonLd)</script>
    }

    @if (!string.IsNullOrWhiteSpace(analytics.GoogleTagManagerId))
    {
        <script>
            (function (w, d, s, l, i) {
                w[l] = w[l] || [];
                w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
                var f = d.getElementsByTagName(s)[0],
                    j = d.createElement(s),
                    dl = l != 'dataLayer' ? '&l=' + l : '';
                j.async = true;
                j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
                f.parentNode.insertBefore(j, f);
            })(window, document, 'script', 'dataLayer', '@analytics.GoogleTagManagerId');
        </script>
    }

    @if (!string.IsNullOrWhiteSpace(analytics.GoogleAnalytics4Id))
    {
        <script async src="https://www.googletagmanager.com/gtag/js?id=@analytics.GoogleAnalytics4Id"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', '@analytics.GoogleAnalytics4Id');
        </script>
    }

    @if (!string.IsNullOrWhiteSpace(analytics.MicrosoftClarityId))
    {
        <script>
            (function (c, l, a, r, i, t, y) {
                c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
                t = l.createElement(r);
                t.async = 1;
                t.src = "https://www.clarity.ms/tag/" + i;
                y = l.getElementsByTagName(r)[0];
                y.parentNode.insertBefore(t, y);
            })(window, document, "clarity", "script", "@analytics.MicrosoftClarityId");
        </script>
    }

    @if (!string.IsNullOrWhiteSpace(analytics.MetaPixelId))
    {
        <script>
            !function (f, b, e, v, n, t, s) {
                if (f.fbq) return;
                n = f.fbq = function () {
                    n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
                };
                if (!f._fbq) f._fbq = n;
                n.push = n;
                n.loaded = !0;
                n.version = '2.0';
                n.queue = [];
                t = b.createElement(e);
                t.async = !0;
                t.src = v;
                s = b.getElementsByTagName(e)[0];
                s.parentNode.insertBefore(t, s);
            }(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
            fbq('init', '@analytics.MetaPixelId');
            fbq('track', 'PageView');
        </script>
    }
</head>
<body>
    @RenderBody()
    @await Component.InvokeAsync("AiAssistantWidget")

    <script src="~/js/navigation.js" asp-append-version="true" defer></script>
    <script src="~/js/animations.js" asp-append-version="true" defer></script>
    <script src="~/js/gallery.js" asp-append-version="true" defer></script>
    <script src="~/js/contact.js" asp-append-version="true" defer></script>
    <script src="~/js/partnership.js" asp-append-version="true" defer></script>
    <script src="~/js/ai-assistant.js" asp-append-version="true" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
