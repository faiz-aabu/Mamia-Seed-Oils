@model MamiaSeedsOil.Web.ViewModels.HomePageViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<MamiaSeedsOil.Web.Resources.SharedResource> T

<a class="skip-link" href="#main-content">@T["SkipToMainContent"]</a>
@await Html.PartialAsync("Partials/_Header", Model)

<main id="main-content">
    @await Html.PartialAsync("Partials/_Hero", Model.Hero)
    @await Html.PartialAsync("Partials/_History", Model.History)
    @await Html.PartialAsync("Partials/_TrustSection", Model.TrustBadges)
    @await Html.PartialAsync("Partials/_Products", Model.Products)
    @await Html.PartialAsync("Partials/_Process", Model.ProcessSteps)
    @await Html.PartialAsync("Partials/_Industries", Model.Industries)
    @await Html.PartialAsync("Partials/_Gallery", Model.Gallery)
    @await Html.PartialAsync("Partials/_Contact", Model)
</main>

@await Html.PartialAsync("Partials/_Footer", Model)
